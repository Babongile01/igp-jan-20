

pipeline
{
	agent any
	stages
	{
		stage('Checkout')
		{
			steps
			{
				git  'https://github.com/Babongile01/igp-jan-20.git'
			}
		}
		
		stage('Compile')
		{
			steps
			{
				sh 'mvn compile'
			}
		}

		stage('Test')
		{
			steps
			{
				sh 'mvn test'
			}
		}

		stage('Packaging')
		{
			steps
			{
				sh 'mvn package'
			}
		}
     }
}

script -->